{
  "expo": {
    "name": "PrankFX",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prankfx",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prankfx.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PrankFX uses the camera to take the photo or record the 5-second clip an effect is applied to.",
        "NSPhotoLibraryUsageDescription": "PrankFX opens your library so you can choose a photo to apply an effect to.",
        "NSPhotoLibraryAddUsageDescription": "PrankFX saves your finished photos and clips back to your library.",
        "NSMicrophoneUsageDescription": "PrankFX records your voice as part of the 5-second Snap clip.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0B1A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.prankfx.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.917307607930-u5kaei1ktf64c8f7h5r6rq7io6hv5gbr"
        }
      ],
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/prankfx-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D0B1A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PrankFX needs access to your photos to apply cinematic effects.",
          "cameraPermission": "PrankFX needs camera access to capture photos for AI effects."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PrankFX needs camera access to capture photos for AI effects.",
          "microphonePermission": "PrankFX records your voice with the 5-second Snap clip.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PrankFX saves your cinematic creations to Photos.",
          "savePhotosPermission": "PrankFX saves your cinematic creations to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22c81c08-f238-43a0-bccb-77ea2438540b"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/22c81c08-f238-43a0-bccb-77ea2438540b",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
