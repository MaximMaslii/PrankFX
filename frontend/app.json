{
  "expo": {
    "name": "PrankFX",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prankfx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prankfx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to apply cinematic effects",
        "NSPhotoLibraryUsageDescription": "Pick photos to transform with AI",
        "NSPhotoLibraryAddUsageDescription": "Save your cinematic creations"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.prankfx.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PrankFX needs access to your photos to apply cinematic effects.",
          "cameraPermission": "PrankFX needs camera access to capture photos for AI effects."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PrankFX needs camera access to capture photos for AI effects."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PrankFX saves your cinematic creations to Photos.",
          "savePhotosPermission": "PrankFX saves your cinematic creations to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22c81c08-f238-43a0-bccb-77ea2438540b"
      }
    }
  }
}
