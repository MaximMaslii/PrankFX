# =============================================================
# PrankFX — frontend environment
# Copy this file to `.env` and fill in the values.
# After changing anything here, restart Metro with:  npx expo start -c
# =============================================================

# Address of the backend, WITHOUT a trailing slash and WITHOUT /api.
# The phone must be able to reach this address, so 'localhost' will NOT work
# for a real device — use your computer's LAN IP (e.g. 192.168.1.42).
#   Windows: ipconfig      macOS/Linux: ifconfig | grep inet
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:8000

# Google OAuth client IDs (optional — defaults are compiled in).
# Override these only if you switch to your own Google Cloud project.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
