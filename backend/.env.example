# =============================================================
# PrankFX — backend environment
# Copy this file to `.env` and fill in the values.
# =============================================================

# --- Database -------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=prankfx

# --- Security -------------------------------------------------
# Use a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256

# How long a login stays valid (minutes). Default is 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Google Sign-In -------------------------------------------
# Comma-separated list of EVERY OAuth client id the app may sign in with.
# Android, iOS and Web clients each issue tokens with their own audience,
# so all three must be listed or verification fails.
GOOGLE_CLIENT_IDS=917307607930-5mulp0qe4b55gvhrno6qbnvmh2a2e1sc.apps.googleusercontent.com,917307607930-u5kaei1ktf64c8f7h5r6rq7io6hv5gbr.apps.googleusercontent.com,917307607930-q5916sbm39ga8bctlvumir4h3jmp4c34.apps.googleusercontent.com

# --- AI -------------------------------------------------------
GEMINI_API_KEY=

# --- Snap (video FX through Decart Lucy) ----------------------
# Key from https://platform.decart.ai — sent as the X-API-KEY header.
DECART_API_KEY=
DECART_API_URL=https://api.decart.ai
# Pinned to Lucy 2.5 (lucy-latest follows whatever Decart ships next).
DECART_MODEL=lucy-2.5
# --- Snap from a photo: which engine ---------------------------
# pixverse = PixVerse v5.5 via fal.ai — real motion from a photo (needs FAL_KEY)
# lucy     = Decart Lucy 2.5 — edits video only, so a photo barely moves;
#            good for the recorded "fire" Snap, weak for photo effects
SNAP_PHOTO_ENGINE=pixverse
# If the main engine fails, try the other one before refunding.
SNAP_PHOTO_FALLBACK=false

# --- Snap from a photo (PixVerse v5.5 via fal.ai) --------------
# Key from https://fal.ai/dashboard/keys. 720p x 5 s = $0.20 per clip.
FAL_KEY=
PIXVERSE_RESOLUTION=720p
PIXVERSE_DURATION=5

# Snap effects that can be made; the rest show "Coming soon" in the app.
# Comma-separated ids or "all", e.g. snap_fire,snap_portal
SNAP_ENABLED_EFFECTS=snap_fire

# What one Snap costs the user (a photo FX costs 1).
SNAP_FX_COST=10
# Raise to 0.6 if test clips show a visible jump at the loop point.
SNAP_XFADE_SECONDS=0.4
# Snap also needs ffmpeg and ffprobe on PATH. Check /api/health.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Remote app control (no app update needed) -----------------
# Below this version the app shows "please update" (only after NATIVE changes).
APP_MIN_VERSION=
APP_LATEST_VERSION=
# true = the app shows a "back soon" screen.
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE_RU=
APP_MAINTENANCE_MESSAGE_EN=
APP_MAINTENANCE_MESSAGE_DE=
APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.prankfx.app
APP_STORE_URL_IOS=

# --- Sign in with Apple on Android ------------------------------
# Services ID from developer.apple.com (Identifiers → Services IDs), e.g.
# com.prankfx.app.signin. Register this return URL on it:
#   https://YOUR-DOMAIN/api/auth/apple/callback
# Empty = the Apple button is shown on iOS only.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
APP_SCHEME=prankfx

# --- Misc -----------------------------------------------------
# "*" or a comma-separated list of allowed browser origins.
CORS_ORIGINS=*
SIGNUP_FX_CREDITS=1

# Dev-only free FX top-up. NEVER set this in a shipped build.
ALLOW_MOCK_PURCHASES=false
