# =============================================================
# PrankFX — backend environment
# Copy this file to `.env` and fill in the values.
# =============================================================

# --- Database -------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=prankfx

# --- Security -------------------------------------------------
# Use a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256

# How long a login stays valid (minutes). Default is 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Google Sign-In -------------------------------------------
# Comma-separated list of EVERY OAuth client id the app may sign in with.
# Android, iOS and Web clients each issue tokens with their own audience,
# so all three must be listed or verification fails.
GOOGLE_CLIENT_IDS=917307607930-5mulp0qe4b55gvhrno6qbnvmh2a2e1sc.apps.googleusercontent.com,917307607930-u5kaei1ktf64c8f7h5r6rq7io6hv5gbr.apps.googleusercontent.com,917307607930-q5916sbm39ga8bctlvumir4h3jmp4c34.apps.googleusercontent.com

# --- AI -------------------------------------------------------
GEMINI_API_KEY=

# --- Misc -----------------------------------------------------
# "*" or a comma-separated list of allowed browser origins.
CORS_ORIGINS=*
SIGNUP_FX_CREDITS=1
